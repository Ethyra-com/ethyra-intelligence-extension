{
  "manifest_version": 3,
  "name": "Ethyra Intelligence — Canvas Export",
  "description": "Export your own Canvas coursework to Ethyra Intelligence for analysis against the ACT College and Career Readiness Standards.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.instructure.com/*"
  ],
  "optional_host_permissions": [
    "*://*.canvas-user-content.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_cors",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "ethyra/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "client-zip.min.js",
        "helpers.js",
        "detector.js",
        "canvas-api.js",
        "ethyra/profile.js",
        "ethyra/manifest.js",
        "downloader.js",
        "ethyra/collect.js",
        "ethyra/archive.js",
        "ethyra/upload.js",
        "ethyra/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ethyra/popup.html",
    "default_title": "Ethyra Intelligence"
  }
}
